# Local development (SQLite file)
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
DEFAULT_REQUIRED_HOURS=8
HALF_DAY_REQUIRED_HOURS=4

# Render free tier — use Turso (free cloud SQLite). Data survives restarts without a paid disk.
# 1. Install Turso CLI: https://docs.turso.tech/cli
# 2. turso db create treffectivour
# 3. turso db show treffectivour --url
# 4. turso db tokens create treffectivour
# 5. Set on Render (and locally for push/seed):
# DATABASE_URL="libsql://treffectivour-YOUR-ORG.turso.io"
# TURSO_AUTH_TOKEN="your-token"
# 6. DATABASE_URL=libsql://... TURSO_AUTH_TOKEN=... npm run db:setup:turso
