generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PunchType {
  IN
  OUT
}

enum DayType {
  FULL
  HALF_DAY_LEAVE
  SPECIAL
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  dayRecords   DayRecord[]
  punches      Punch[]
}

model DayRecord {
  id             String   @id @default(cuid())
  userId         String
  date           String
  dayType        DayType  @default(FULL)
  requiredHours  Float    @default(8)
  notes          String?
  goalNotifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  punches        Punch[]

  @@unique([userId, date])
  @@index([userId, date])
}

model Punch {
  id          String     @id @default(cuid())
  userId      String
  dayRecordId String
  type        PunchType
  timestamp   DateTime
  isManual    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayRecord   DayRecord  @relation(fields: [dayRecordId], references: [id], onDelete: Cascade)

  @@index([dayRecordId, timestamp])
}

model SpecialDay {
  id            String   @id @default(cuid())
  date          String   @unique
  name          String
  requiredHours Float
  createdAt     DateTime @default(now())
}
